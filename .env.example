# Salin ke .env lalu sesuaikan. JANGAN commit .env.

# Postgres (docker-compose.yml expose di host port 5433 supaya tidak bentrok
# dengan Postgres lokal lain di 5432)
DATABASE_URL=postgresql://simantra:simantra_dev@localhost:5433/simantra?schema=public

# WAJIB diisi 'production' saat deploy. Selain mengubah default COOKIE_SECURE,
# ini juga yang membedakan perilaku fallback dev vs produksi.
NODE_ENV=development
# Container hosting umumnya UTC. Tanpa ini cron agregasi analitik (00:15)
# menghitung batas hari yang salah untuk data WIB.
TZ=Asia/Jakarta

# 3001 sering dipakai Docker Desktop di Windows — default 3002
PORT=3002
# Daftar origin frontend, dipisah koma TANPA spasi. Dipakai CORS REST sekaligus
# gateway WebSocket. Kalau dikosongkan, SEMUA origin diizinkan + credentials —
# jangan pernah dibiarkan kosong di produksi.
CORS_ORIGIN=http://localhost:3000

# Auth (§2 DESIGN.md)
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7

# Cookie refresh token. Frontend & backend BEDA domain (mis. Vercel + Railway)
# → wajib SameSite=none + Secure, kalau tidak cookie tidak pernah terkirim dan
# user ke-logout tiap reload. Satu domain induk (app./api.) → cukup 'lax'.
# COOKIE_SECURE default ikut NODE_ENV=production. SameSite=none otomatis
# memaksa Secure karena browser menolaknya kalau tidak.
COOKIE_SAMESITE=lax
# COOKIE_SECURE=true
# COOKIE_DOMAIN=.contoh.com

# Rate limiting (AppThrottlerGuard, common/guards/app-throttler.guard.ts):
# route publik (@Public()) pakai THROTTLE_LIMIT, route staff (butuh JWT) pakai
# THROTTLE_STAFF_LIMIT yang lebih longgar — endpoint publik dapat limit lebih
# ketat lagi via dekorator @Throttle() per-route kalau perlu.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
THROTTLE_STAFF_LIMIT=300

# Storage (§3.3 DESIGN.md) — 'local' untuk dev, 'r2' untuk produksi.
# Filesystem platform hosting bersifat ephemeral: dengan 'local' di produksi,
# semua unggahan hilang tiap redeploy sementara baris DB tetap menunjuk URL 404.
STORAGE_DRIVER=local
# Dipakai driver local; pada driver r2 ini cuma folder staging sementara video.
STORAGE_LOCAL_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:3002

# Cloudflare R2 — hanya dibaca saat STORAGE_DRIVER=r2 (dan wajib lengkap,
# kalau tidak aplikasi gagal boot dengan pesan jelas).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=simantra-uploads
# URL publik bucket, TANPA slash di akhir. Nilainya ikut tersimpan permanen di
# dalam URL file pada database — menggantinya nanti butuh rewrite data.
# R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev

# Email (forgot-password) — Resend (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM="SIMANTRA <noreply@simantra.fadhilfa.my.id>"
# Origin frontend Next.js, dipakai untuk build link reset-password di email
FRONTEND_BASE_URL=http://localhost:3000
RESET_TOKEN_TTL_MINUTES=60
