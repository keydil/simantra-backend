# Salin ke .env lalu sesuaikan. JANGAN commit .env.

# Postgres (docker-compose.yml expose di host port 5433 supaya tidak bentrok
# dengan Postgres lokal lain di 5432)
DATABASE_URL=postgresql://simantra:simantra_dev@localhost:5433/simantra?schema=public

# 3001 sering dipakai Docker Desktop di Windows — default 3002
PORT=3002
CORS_ORIGIN=http://localhost:3000

# Auth (§2 DESIGN.md)
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7

# Rate limiting (AppThrottlerGuard, common/guards/app-throttler.guard.ts):
# route publik (@Public()) pakai THROTTLE_LIMIT, route staff (butuh JWT) pakai
# THROTTLE_STAFF_LIMIT yang lebih longgar — endpoint publik dapat limit lebih
# ketat lagi via dekorator @Throttle() per-route kalau perlu.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
THROTTLE_STAFF_LIMIT=300

# Storage (§3.3 DESIGN.md) — local untuk dev
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:3002

# Email (forgot-password) — Resend (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM="SIMANTRA <noreply@simantra.fadhilfa.my.id>"
# Origin frontend Next.js, dipakai untuk build link reset-password di email
FRONTEND_BASE_URL=http://localhost:3000
RESET_TOKEN_TTL_MINUTES=60
